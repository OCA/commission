<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="commission_tree" model="ir.ui.view">
        <field name="name">commissions list</field>
        <field name="model">commission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="commission_type" />
                <field name="settlement_type" />
                <field name="amount_base_type" />
            </list>
        </field>
    </record>
    <record id="commission_form" model="ir.ui.view">
        <field name="name">commissions form</field>
        <field name="model">commission</field>
        <field name="arch" type="xml">
            <form string="Commission">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group string="General information">
                        <group>
                            <field name="name" />
                        </group>
                        <group name="commision_params">
                            <field name="commission_type" />
                            <field name="settlement_type" />
                            <field name="amount_base_type" />
                        </group>
                    </group>
                    <group string="Rates definition" colspan="4">
                        <group colspan="2">
                            <field
                                name="fix_qty"
                                invisible="(commission_type != 'fixed')"
                                required="(commission_type == 'fixed')"
                            />
                        </group>
                        <field
                            name="section_ids"
                            colspan="4"
                            nolabel="1"
                            invisible="(commission_type != 'section')"
                        >
                            <list editable="bottom">
                                <field name="amount_from" />
                                <field name="amount_to" />
                                <field name="percent" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_commission" model="ir.actions.act_window">
        <field name="name">Commission types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">commission</field>
        <field name="binding_view_types">form,list</field>
    </record>
    <menuitem
        id="menu_commission_type"
        name="Commission types"
        parent="commission_oca.menu_commission_management"
        action="action_commission"
    />
</odoo>
