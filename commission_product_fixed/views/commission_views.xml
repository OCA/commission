<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="commission_form" model="ir.ui.view">
        <field name="name">commission.form.product.fixed</field>
        <field name="model">commission</field>
        <field name="inherit_id" ref="commission_oca.commission_form" />
        <field name="arch" type="xml">
            <field name="section_ids" position="after">
                <field
                    name="product_line_ids"
                    colspan="4"
                    nolabel="1"
                    invisible="(commission_type != 'product_fixed')"
                >
                    <list editable="bottom">
                        <field name="sequence" widget="handle" />
                        <field name="product_id" />
                        <field name="min_qty" />
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="amount" />
                        <field name="currency_id" optional="hide" />
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
