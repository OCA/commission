<data>
    <record id="view_settlement_line_tree" model="ir.ui.view">
        <field name="model">commission.settlement.line</field>
        <field name="inherit_id" ref="commission.view_settlement_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commission_id']" position="after">
                <field name="price_compliance_tier" />
            </xpath>
        </field>
    </record>
    <record id="view_settlement_line_search" model="ir.ui.view">
        <field name="model">commission.settlement.line</field>
        <field name="inherit_id" ref="commission.view_settlement_line_search" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    string="Price Compliance Tier"
                    name="group_price_compliance_tier"
                    domain="[]"
                    context="{'group_by':'price_compliance_tier'}"
                />
            </xpath>
        </field>
    </record>
</data>
