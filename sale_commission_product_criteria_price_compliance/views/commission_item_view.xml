<data>
    <record id="commission_item_form_view" model="ir.ui.view">
        <field name="model">commission.item</field>
        <field
            name="inherit_id"
            ref="sale_commission_product_criteria.commission_item_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="price_compliance_tier" />
            </xpath>
        </field>
    </record>
    <record id="commission_item_tree_view" model="ir.ui.view">
        <field name="model">commission.item</field>
        <field
            name="inherit_id"
            ref="sale_commission_product_criteria.commission_item_tree_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="price_compliance_tier" />
            </xpath>
        </field>
    </record>
    <record id="commission_item_search" model="ir.ui.view">
        <field name="model">commission.item</field>
        <field
            name="inherit_id"
            ref="sale_commission_product_criteria.commission_item_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    string="Price Compliance Tier"
                    name="group_price_compliance_tier"
                    domain="[]"
                    context="{'group_by':'price_compliance_tier'}"
                />
            </xpath>
        </field>
    </record>
</data>
