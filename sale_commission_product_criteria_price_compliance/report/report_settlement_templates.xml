<odoo>
    <template
        id="report_settlement_document"
        inherit_id="commission.report_settlement_document"
    >
        <xpath
            expr="//table[@name='invoice_line_table']/thead/tr/th[last()]"
            position="before"
        >
            <th class="text-start">Price Compliance</th>
        </xpath>
        <xpath
            expr="//table[@name='invoice_line_table']/tbody/tr/td/span[@t-field='l.commission_id']/.."
            position="after"
        >
            <td class="text-start">
                <span t-field="l.price_compliance_tier" />
            </td>
        </xpath>
    </template>
</odoo>
