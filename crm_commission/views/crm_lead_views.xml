<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add lead_agent_ids to opportunity form (type == 'opportunity' group) -->
    <record id="crm_lead_view_form_commission" model="ir.ui.view">
        <field name="name">crm.lead.form.commission</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='tag_ids'][ancestor::group[@invisible=&quot;type == 'lead'&quot;]]"
                position="after"
            >
                <field
                    name="lead_agent_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    placeholder="Agentes comissionados"
                />
            </xpath>
            <xpath
                expr="//group[@name='lead_priority']//field[@name='tag_ids']"
                position="after"
            >
                <field
                    name="lead_agent_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    placeholder="Agentes comissionados"
                />
            </xpath>
        </field>
    </record>
</odoo>
